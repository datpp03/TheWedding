{
  "name": "the-wedding",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant wedding photo and video platform",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "local:control": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-control.ps1",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.34.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.2.0",
      "multer": "2.2.0",
      "postcss": "8.5.15"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "unrs-resolver"
    ]
  }
}
