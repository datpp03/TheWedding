NODE_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgresql://the_wedding:ChangeMePostgres!123@localhost:5432/the_wedding
# Use true for Neon, false for local Docker PostgreSQL, or auto to infer from NODE_ENV/URL.
DATABASE_SSL=false
POSTGRES_DB=the_wedding
POSTGRES_USER=the_wedding
POSTGRES_PASSWORD=ChangeMePostgres!123

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-strong-cookie-secret
CORS_ORIGINS=http://localhost:3000

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Leave empty when Redis is disabled for the early free-hosting stage.
REDIS_URL=

MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe!123456
